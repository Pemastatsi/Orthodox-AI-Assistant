{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retrieval-plan.schema.json",
  "title": "RetrievalPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "semanticQuery",
    "answerMode",
    "tenantId",
    "filters",
    "k"
  ],
  "properties": {
    "semanticQuery": {
      "type": "string",
      "description": "Phase 1 must equal classifiedQuery.reframedQuery ?? classifiedQuery.rawQuery."
    },
    "answerMode": { "$ref": "answer-mode.schema.json" },
    "tenantId": {
      "type": "string",
      "description": "Adapter-injected. The Qdrant adapter MUST overwrite this with Principal.tenantId regardless of the value emitted by A2; the field is present in the schema so generated client code can deserialize the plan, but a model-emitted value MUST NOT reach Qdrant. See docs/contracts/auth-context.md and docs/contracts/code-gen-guide.md."
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "tenantId"],
      "properties": {
        "tenantId": {
          "type": "string",
          "description": "Adapter-injected. Always equals Principal.tenantId at the Qdrant call boundary; any other value is treated as a bug."
        },
        "approved": { "const": true },
        "visibility": {
          "type": "array",
          "items": { "type": "string" }
        },
        "language": { "type": "string" },
        "categories": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "boosts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "value", "weight"],
        "properties": {
          "field": { "type": "string" },
          "value": { "type": "string" },
          "weight": { "type": "number" }
        }
      }
    },
    "k": { "type": "integer", "minimum": 1, "maximum": 20, "default": 8 },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "description": "Retrieval mode flags. Phase 1 default: vector-only. Hybrid and reranker are reserved for ADR-approved enablement.",
      "properties": {
        "useBM25": { "type": "boolean", "default": false },
        "useHybrid": { "type": "boolean", "default": false },
        "reranker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "model": { "type": ["string", "null"] }
          }
        }
      }
    },
    "conceptExpansion": {
      "type": "null",
      "description": "Reserved for later ADR-approved graph-grounded expansion; null in Phase 1."
    }
  }
}
