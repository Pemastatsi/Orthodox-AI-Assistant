{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "billing-usage.schema.json",
  "title": "BillingUsage",
  "description": "Per-tenant rolling usage row used by the Stripe metered meter. servedAnswerCount is the meter; freshModelRunCount is internal cost tracking only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "periodStart",
    "periodEnd",
    "servedAnswerCount",
    "freshModelRunCount"
  ],
  "properties": {
    "tenantId": { "type": "string" },
    "periodStart": { "type": "string", "format": "date-time" },
    "periodEnd": { "type": "string", "format": "date-time" },
    "servedAnswerCount": { "type": "integer", "minimum": 0 },
    "freshModelRunCount": { "type": "integer", "minimum": 0 },
    "promptTokens": { "type": "integer", "minimum": 0 },
    "completionTokens": { "type": "integer", "minimum": 0 },
    "embeddingTokens": { "type": "integer", "minimum": 0 },
    "stripeUsageRecordId": { "type": ["string", "null"] },
    "reportedAt": { "type": ["string", "null"], "format": "date-time" }
  }
}
