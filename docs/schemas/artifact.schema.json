{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact",
  "title": "Artifact",
  "description": "Base artifact envelope for all Phase 2 rich-output types.",
  "type": "object",
  "required": [
    "artifactId", "tenantId", "requestingUserId", "artifactType", "status",
    "sourceRunId", "evidencePacketHash", "citationRefs", "artifactRouteId",
    "locale", "outputFormats", "contentHash", "provenance", "approvalRecord",
    "failureReason", "createdAt", "updatedAt", "exportedAt"
  ],
  "properties": {
    "artifactId": { "type": "string", "description": "ULID" },
    "tenantId": { "type": "string" },
    "requestingUserId": { "type": "string" },
    "artifactType": {
      "type": "string",
      "enum": [
        "lineage_graph", "council_timeline", "citation_network",
        "dispute_map", "manuscript_witness_tree", "mind_map",
        "study_packet", "sermon_outline", "slide_deck",
        "catechism_lesson_plan", "parish_bulletin_insert",
        "bishop_briefing", "syllabus_bundle", "feast_day_bundle", "parish_faq_draft",
        "audio_overview",
        "bilingual_passage", "liturgical_overlay", "iconographic_card",
        "monastery_map", "disputation_response"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["requested", "evidence_check", "generating", "verifying", "pending_review", "approved", "exported", "rejected", "failed"]
    },
    "sourceRunId": { "type": "string", "description": "run_traces.run_id that produced the evidence packet" },
    "evidencePacketHash": { "type": "string", "description": "SHA-256 of the serialized EvidencePacket" },
    "citationRefs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "All chunk_id values cited in this artifact. Non-empty before status leaves verifying."
    },
    "artifactRouteId": { "type": "string", "description": "model_routes.routeId of the ArtifactProvider used" },
    "locale": { "type": "string", "description": "BCP 47 locale (e.g. en, el, sl)" },
    "outputFormats": {
      "type": "array",
      "items": { "type": "string", "enum": ["pdf", "docx", "pptx", "html", "json", "mp3"] },
      "minItems": 1
    },
    "contentHash": { "type": "string", "description": "SHA-256 of the rendered artifact content" },
    "provenance": {
      "type": "object",
      "required": ["allClaimsVerified", "verifiedClaimCount", "unverifiedClaimCount"],
      "properties": {
        "allClaimsVerified": { "type": "boolean" },
        "verifiedClaimCount": { "type": "integer", "minimum": 0 },
        "unverifiedClaimCount": { "type": "integer", "minimum": 0 },
        "coverageScore": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "approvalRecord": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["approvedBy", "approvedAt", "decision"],
          "properties": {
            "approvedBy": { "type": "string" },
            "approvedAt": { "type": "string", "format": "date-time" },
            "decision": { "type": "string", "enum": ["approved", "rejected"] },
            "reviewerComment": { "type": "string", "maxLength": 1000 }
          }
        }
      ]
    },
    "failureReason": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "exportedAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": true
}
