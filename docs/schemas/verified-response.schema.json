{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verified-response.schema.json",
  "title": "VerifiedResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "answer",
    "confidenceTier",
    "handling",
    "citations",
    "verification",
    "reframing",
    "usage",
    "servedFromCache",
    "schemaVersion"
  ],
  "oneOf": [
    {
      "title": "SuccessResponse",
      "description": "Successful response paths must carry a runId.",
      "required": ["runId"],
      "properties": {
        "handling": {
          "enum": ["answer", "answer_with_disclaimer", "reframe_to_teaching"]
        }
      }
    },
    {
      "title": "BoundedFallbackResponse",
      "description": "Always present. Even on hard-safety bypass, a runId is minted and a minimal run_traces row is persisted (see phase1-implementation-contract.md §Run-trace persistence is unconditional).",
      "required": ["runId"],
      "properties": {
        "handling": {
          "enum": ["block_with_redirect", "insufficient_evidence"]
        }
      }
    }
  ],
  "properties": {
    "answer": { "type": "string" },
    "confidenceTier": {
      "type": "string",
      "enum": ["GREEN", "YELLOW", "RED"]
    },
    "handling": {
      "type": "string",
      "enum": [
        "answer",
        "answer_with_disclaimer",
        "reframe_to_teaching",
        "block_with_redirect",
        "insufficient_evidence"
      ]
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "citationId",
          "chunkId",
          "sourceId",
          "title",
          "sourceHash",
          "chunkHash",
          "approved",
          "corpusOrigin"
        ],
        "properties": {
          "citationId": { "type": "string" },
          "chunkId": { "type": "string" },
          "sourceId": { "type": "string" },
          "title": { "type": "string" },
          "work": { "type": ["string", "null"] },
          "father": { "type": ["string", "null"] },
          "page": { "type": ["string", "null"] },
          "timestamp": { "type": ["string", "null"] },
          "quote": { "type": ["string", "null"] },
          "sourceHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Source-level integrity hash carried from EvidencePacket admittedChunks.sourceHash."
          },
          "chunkHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Chunk-level integrity hash carried from EvidencePacket admittedChunks.chunkHash."
          },
          "approved": {
            "const": true,
            "description": "Always true. A6 admits only approved chunks; this is restated on the user-facing citation for downstream consumers and audit."
          },
          "corpusOrigin": {
            "type": "string",
            "enum": ["tenant", "starter_corpus"],
            "description": "Disclosure of the corpus the chunk came from. starter_corpus only appears when the tenant has the (Phase 2) feature enabled."
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["passed", "checkedAt", "verifierVersion"],
      "properties": {
        "passed": { "type": "boolean" },
        "checkedAt": { "type": "string", "format": "date-time" },
        "verifierVersion": { "type": "string" },
        "failureReason": { "type": ["string", "null"] }
      }
    },
    "reframing": {
      "type": "object",
      "required": ["wasReframed"],
      "properties": {
        "wasReframed": { "type": "boolean" },
        "originalQuery": { "type": ["string", "null"] },
        "reframedQuery": { "type": ["string", "null"] },
        "disclosureText": { "type": ["string", "null"] }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "servedAnswerCount",
        "freshModelRunCount",
        "modelRouteId"
      ],
      "description": "Per-request accounting per ADR 0005. servedAnswerCount is always incremented (cache or fresh). freshModelRunCount only on cache miss.",
      "properties": {
        "servedAnswerCount": { "type": "integer", "minimum": 0, "maximum": 1 },
        "freshModelRunCount": { "type": "integer", "minimum": 0, "maximum": 1 },
        "modelRouteId": { "type": ["string", "null"] },
        "promptTokens": { "type": ["integer", "null"], "minimum": 0 },
        "completionTokens": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "runId": {
      "type": "string",
      "description": "ULID identifying the pipeline run. Always present. Even on hard-safety bypass, a runId is minted and a minimal run_traces row is persisted (see phase1-implementation-contract.md §Run-trace persistence is unconditional)."
    },
    "servedFromCache": { "type": "boolean" },
    "schemaVersion": {
      "type": "string",
      "description": "Format YYYY-MM-DD.NN per docs/contracts/api-versioning.md."
    }
  }
}
