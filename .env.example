# --- Service ---
APP_ENV=development          # development | staging | production
SERVICE_VERSION=0.0.1
LOG_LEVEL=info

# --- Postgres ---
# The request path connects via DATABASE_URL. In production point it at the `app_runtime` role
# (non-superuser, subject to RLS) so Postgres RLS (ADR-0016) enforces tenant isolation. The dev
# default below is the bootstrap superuser, which BYPASSES RLS — fine locally, never in production.
DATABASE_URL=postgresql+asyncpg://orthodox:orthodox@localhost:5432/orthodox

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
RESPONSE_CACHE_TTL_SECONDS=3600

# --- Qdrant ---
QDRANT_URL=                      # in-network Railway URL or Qdrant Cloud endpoint
QDRANT_COLLECTION=patristic      # or per-tenant collection name pattern
QDRANT_COLLECTION_PREFIX=chunks  # shared-collection topology per ADR-0013
QDRANT_API_KEY=                  # leave blank for self-hosted Qdrant without auth

# --- Auth ---
AUTH_PROVIDER=dev                # dev | clerk; default is dev for local. APP_ENV=production refuses to boot if AUTH_PROVIDER=dev (see auth-context.md §Development Mode).

# --- Clerk ---
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_JWT_ISSUER=https://REPLACE_ME.clerk.accounts.dev   # Clerk Frontend API URL; JWKS is fetched from {issuer}/.well-known/jwks.json. Required when AUTH_PROVIDER=clerk.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000           # comma-separated allowlist matched against the JWT `azp` claim. Required when AUTH_PROVIDER=clerk.
CLERK_JWKS_CACHE_SECONDS=3600                             # JWKS signing-key cache lifetime; keep <= Clerk's ~1h TTL (auth-context.md §Forbidden patterns).

# --- PDF Parsing (T-002 ingestion) ---
TESSERACT_BINARY_PATH=/usr/bin/tesseract
TESSERACT_LANGUAGE_PACK_PATH=/usr/share/tesseract-ocr/4.00/tessdata

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_USAGE_METER=served_answer_count

# --- LLM providers ---
ANTHROPIC_API_KEY=REPLACE_ME
OPENAI_API_KEY=REPLACE_ME

# --- Make.com webhooks ---
MAKE_WEBHOOK_SECRET=REPLACE_ME   # HMAC secret; can be left as REPLACE_ME until Make.com integration is activated (Phase 2). The endpoint returns 501 until then.

# --- Sensitive log encryption ---
SENSITIVE_LOG_DATA_KEY_BASE64=   # base64-encoded AES-256 key for application-level envelope encryption of raw sensitive logs; rotate via Railway secret manager. Required when APP_ENV=production.
SENSITIVE_LOG_KEY_VERSION=v1     # active key version label written into raw_sensitive_logs.key_version; bump alongside SENSITIVE_LOG_DATA_KEY_BASE64 during key rotation
SENSITIVE_LOG_RETENTION_DAYS=30

# --- Retention worker ---
RETENTION_WORKER_CRON=5 * * * *  # cron schedule for the sensitive-log retention worker; see ADR-0005 §Retention
DATABASE_ADMIN_URL=              # asyncpg URL for the app_admin role (BYPASSRLS) used by migrations, seeders, the retention/ingestion workers, and Clerk auth identity resolution (reads tenants/users before a tenant GUC exists — ADR-0016 Rules 3 & 5); falls back to DATABASE_URL when unset. In production set this to app_admin and DATABASE_URL to app_runtime.

# --- Versions (read at startup) ---
ACTIVE_SCHEMA_VERSION=2026-05-01.1
ACTIVE_PROMPT_VERSION_A1A2=qa_analyze@2026-05-01.1
ACTIVE_PROMPT_VERSION_A5=a5_compose@2026-05-01.1
ACTIVE_MODEL_ROUTE_A1A2=qa_analyze_anthropic@2026-05-01.1
ACTIVE_MODEL_ROUTE_A5=a5_compose_anthropic@2026-05-01.1
ACTIVE_MODEL_ROUTE_EMBEDDING=embedding_openai@2026-05-01.1
ACTIVE_MODEL_ROUTE_VERIFIER=     # optional; absence disables A6 judge (deterministic citation checks still run)

# --- Frontend ---
NEXT_PUBLIC_AUTH_MODE=dev         # dev | clerk. dev keeps the x-dev-principal flow (no Clerk keys needed); set to clerk in staging/prod to send real Clerk JWTs (requires a real NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY). Backend CLERK_AUTHORIZED_PARTIES must include the frontend origin.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
